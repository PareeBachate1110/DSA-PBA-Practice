class HashTable:
    def __init__(self, size):
        self.size = size
        self.table = [-1] * size

    def hash_function(self, key):
        return key % self.size

    def insert_without_replacement(self, key):
        index = self.hash_function(key)
        start = index

        while self.table[index] != -1:
            index = (index + 1) % self.size
            if index == start:
                return

        self.table[index] = key

    def insert_with_replacement(self, key):
        index = self.hash_function(key)

        if self.table[index] == -1:
            self.table[index] = key
            return

        if self.hash_function(self.table[index]) != index:
            displaced = self.table[index]
            self.table[index] = key
            key = displaced

        index = (index + 1) % self.size
        start = index

        while self.table[index] != -1:
            index = (index + 1) % self.size
            if index == start:
                return

        self.table[index] = key

    def search(self, key):
        index = self.hash_function(key)
        start = index

        while self.table[index] != -1:
            if self.table[index] == key:
                return index

            index = (index + 1) % self.size

            if index == start:
                break

        return -1

    def display(self):
        for i in range(self.size):
            print(i, ":", self.table[i])


size = int(input())
choice = int(input())
n = int(input())

keys = list(map(int, input().split()))

h = HashTable(size)

for key in keys[:n]:
    if choice == 1:
        h.insert_without_replacement(key)
    elif choice == 2:
        h.insert_with_replacement(key)

h.display()

key = int(input())
result = h.search(key)

if result == -1:
    print("Key not found")
else:
    print("Key found at index:", result)
