def bfs(start):
    visited = [False] * n
    queue = [start]
    result = []

    visited[start] = True

    while queue:
        vertex = queue.pop(0)
        result.append(str(vertex))

        for i in graph[vertex]:
            if visited[i] == False:
                visited[i] = True
                queue.append(i)

    return "BFS : " + " ".join(result)


n = int(input())

graph = []
for i in range(n):
    neighbours = list(map(int, input().split()))
    graph.append(neighbours)

start = int(input())

print(bfs(start))
