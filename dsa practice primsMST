n = int(input())

matrix = []

for i in range(n):
    row = list(map(int, input().split()))
    matrix.append(row)

visited = [False] * n
visited[0] = True

total_cost = 0
count = 0

print("Edges in MST:")

while count < n - 1:
    minimum = float('inf')
    x = -1
    y = -1

    for i in range(n):
        if visited[i] == True:
            for j in range(n):
                if visited[j] == False and matrix[i][j] != 0:
                    if matrix[i][j] < minimum:
                        minimum = matrix[i][j]
                        x = i
                        y = j

    print(x, "-", y, ":", minimum)

    total_cost += minimum
    visited[y] = True
    count += 1

print("Total minimum cost:", total_cost)
